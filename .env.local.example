# Copy this file to `.env.local` and fill in the values from
# your Supabase project: https://app.supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxx

# Legacy name (still supported as a fallback):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only needed for privileged server-side operations (NEVER expose to the browser):
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shared passphrase that gates access to the entire app.
APP_ACCESS_KEY=change-me

# Optional: auto-create tables via npm run db:setup
# Supabase → Project Settings → Database → Database password
# SUPABASE_DB_PASSWORD=your-database-password
